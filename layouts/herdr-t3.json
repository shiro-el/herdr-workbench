{
  "id": "root",
  "cloned_from": {
    "name": "main",
    "version": "0.1.10"
  },
  "type": "row",
  "preview": "layouts/herdr-t3.svg",
  "divider": {
    "width": 1,
    "color": "border"
  },
  "children": [
    {
      "id": "sidebar",
      "type": "column",
      "children": [
        {
          "id": "brand",
          "type": "block",
          "content": {
            "mod": "t3-chrome"
          },
          "size": {
            "px": 40
          },
          "window_drag": true
        },
        {
          "id": "sidebar-lists",
          "type": "stack",
          "active": "inbox",
          "children": [
            {
              "id": "lists",
              "type": "column",
              "children": [
                {
                  "id": "spaces",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "t3-spaces"
                  }
                },
                {
                  "id": "agents",
                  "type": "block",
                  "size": {
                    "weight": 1
                  },
                  "min": 90,
                  "content": {
                    "mod": "t3-agents"
                  }
                }
              ]
            },
            {
              "id": "inbox",
              "type": "block",
              "content": {
                "mod": "t3-inbox",
                "props": {
                  "newMenu": "t3-new-menu"
                }
              }
            }
          ]
        },
        {
          "id": "usage",
          "type": "block",
          "content": {
            "mod": "usage-meter"
          },
          "size": {
            "px": 66
          },
          "resizable": false
        },
        {
          "id": "sidebar-footer",
          "type": "block",
          "content": {
            "mod": "t3-chrome",
            "props": {
              "footer": true
            }
          },
          "size": {
            "px": 40
          }
        }
      ],
      "size": {
        "px": 256
      },
      "min": 208,
      "max": 480,
      "background": "chrome",
      "resizable": false
    },
    {
      "id": "work",
      "type": "column",
      "children": [
        {
          "id": "tabs-row",
          "type": "row",
          "size": {
            "px": 40
          },
          "resizable": false,
          "background": "chrome",
          "children": [
            {
              "id": "tabs",
              "type": "block",
              "size": {
                "weight": 1
              },
              "window_drag": true,
              "content": {
                "mod": "t3-tabs"
              }
            },
            {
              "id": "actions",
              "type": "block",
              "size": {
                "px": 108
              },
              "window_drag": true,
              "content": {
                "mod": "t3-actions",
                "props": {
                  "block": "actions"
                }
              }
            },
            {
              "id": "tabs-end",
              "type": "block",
              "size": {
                "px": 33
              },
              "window_drag": true,
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "end",
                  "block": "tabs-end"
                }
              }
            }
          ]
        },
        {
          "id": "work-body",
          "type": "row",
          "children": [
            {
              "id": "main",
              "type": "block",
              "content": {
                "tab": "active",
                "pane": {
                  "header": {
                    "content": {
                      "mod": "t3-pane"
                    },
                    "reveal": "always",
                    "height": 28,
                    "position": "top"
                  },
                  "background": "background",
                  "border": {
                    "width": 2,
                    "color": "background"
                  },
                  "focus": {
                    "width": 2,
                    "color": "background"
                  },
                  "radius": 8,
                  "gap": 8,
                  "lone": true
                }
              }
            },
            {
              "id": "panel",
              "type": "column",
              "gap": 4,
              "children": [
                {
                  "id": "panel-nav",
                  "type": "block",
                  "size": {
                    "px": 30
                  },
                  "content": {
                    "mod": "t3-panel",
                    "props": {
                      "view": "nav"
                    }
                  }
                },
                {
                  "id": "panel-body",
                  "type": "stack",
                  "active": "changes",
                  "size": {
                    "weight": 1
                  },
                  "children": [
                    {
                      "id": "files",
                      "type": "block",
                      "content": {
                        "mod": "t3-files"
                      }
                    },
                    {
                      "id": "search",
                      "type": "block",
                      "content": {
                        "mod": "t3-panel",
                        "props": {
                          "view": "search"
                        }
                      }
                    },
                    {
                      "id": "changes",
                      "type": "block",
                      "content": {
                        "mod": "git"
                      }
                    },
                    {
                      "id": "github",
                      "type": "block",
                      "content": {
                        "mod": "github"
                      }
                    },
                    {
                      "id": "worktrees",
                      "type": "block",
                      "content": {
                        "mod": "t3-panel",
                        "props": {
                          "view": "worktrees"
                        }
                      }
                    },
                    {
                      "id": "ports",
                      "type": "block",
                      "content": {
                        "mod": "t3-panel",
                        "props": {
                          "view": "ports"
                        }
                      }
                    },
                    {
                      "id": "machine",
                      "type": "block",
                      "content": {
                        "mod": "t3-panel",
                        "props": {
                          "view": "machine"
                        }
                      }
                    }
                  ]
                }
              ],
              "size": {
                "px": 380
              },
              "min": 280,
              "max": 900,
              "hidden": true
            }
          ],
          "padding": [
            2,
            8
          ],
          "gap": 8
        },
        {
          "id": "work-bottom-inset",
          "type": "row",
          "children": [
            {
              "id": "bar-measure",
              "type": "block",
              "size": {
                "weight": 1
              },
              "content": {
                "mod": "t3-tabs",
                "props": {
                  "part": "measure"
                }
              }
            }
          ],
          "size": {
            "px": 6
          }
        },
        {
          "id": "status",
          "type": "block",
          "hidden": true,
          "size": {
            "px": 28
          },
          "content": {
            "mod": "workspace-status"
          }
        }
      ],
      "background": "chrome",
      "resizable": false
    }
  ],
  "background": "canvas",
  "terminal_opacity": 0,
  "terminal_padding": [
    8,
    0
  ],
  "titlebar": "none",
  "terminal_menu": "t3-menu",
  "traffic_lights": [
    16,
    13
  ]
}
